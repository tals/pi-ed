{
  "name": "pi-ed-extension",
  "version": "0.1.4",
  "description": "Explicit one-shot prompt rewriter extension for pi — append /ed to a rough prompt, preview the rewrite, accept or reject.",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-mono"
  ],
  "homepage": "https://github.com/tals/ed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tals/ed.git"
  },
  "bugs": {
    "url": "https://github.com/tals/ed/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "ed.ts",
  "exports": {
    ".": "./ed.ts"
  },
  "pi": {
    "extensions": ["ed.ts"]
  },
  "files": [
    "ed.ts",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.79.0",
    "@earendil-works/pi-coding-agent": ">=0.79.0",
    "@earendil-works/pi-tui": ">=0.79.0"
  }
}
